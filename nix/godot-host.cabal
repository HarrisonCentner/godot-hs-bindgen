cabal-version: 3.0
name:          godot-host
version:       0.1.0.0
synopsis:      Run Godot inside a Haskell program, as a library
description:
  Links libgodot, the Godot engine built as a shared library, and starts it
  from Haskell. Godot.LibGodot is generated by hs-bindgen from libgodot.h,
  reusing the types of the gdextension-interface package; Godot.Host is
  hand-written. The source tree for this package is assembled by the
  godot-host-src derivation in nix/godot-bindings.nix.

license:       MIT
category:      Game
build-type:    Simple

library
  hs-source-dirs:     src
  exposed-modules:
    Godot.Host
    Godot.Host.Live
    Godot.LibGodot

  -- libgodot.h and the interface header it includes, for the C stubs that
  -- hs-bindgen embeds in Godot.LibGodot.
  include-dirs:       include
  extra-libraries:    godot
  build-depends:
    , async
    , base
    , gdextension-interface
    , godot-api
    , hs-bindgen-runtime
    , stm

  default-extensions:
    DerivingStrategies
    ImportQualifiedPost
    LambdaCase
    NamedFieldPuns
    RecordWildCards
    StrictData

  default-language:   GHC2021
