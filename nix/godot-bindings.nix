# Derivations for everything derived from the Godot engine. None of their
# outputs are checked in.
#
# This is a plain function, not a flake module: the flake exposes it as
# `lib.mkBindings` so that other flakes can build the bindings against their
# own package set, and ./modules/flake/haskell.nix uses it as a package source.

# `classes` limits the engine API to those classes and their ancestors; the
# default, an empty list, generates every class.
{ pkgs, hs-bindgen-cli, classes ? [ ] }:
let
  # The godot-host package calls these itself, so they are generated
  # whatever the caller lists. An empty list already means every class.
  hostClasses = [ "GodotInstance" "Engine" "SceneTree" "Window" "Node3D" ];
  selectedClasses = if classes == [ ] then [ ] else pkgs.lib.unique (classes ++ hostClasses);
in
rec {
  # The GDExtension C header and JSON API descriptions, dumped from the same
  # Godot binary the devShell provides, so they always match the engine.
  godot-api-json = pkgs.runCommand "godot-api-json-${pkgs.godot.version}"
    {
      nativeBuildInputs = [ pkgs.godot ];
    } ''
    export HOME=$TMPDIR
    mkdir -p $out
    cd $out
    godot --headless \
      --dump-gdextension-interface \
      --dump-gdextension-interface-json \
      --dump-extension-api-with-docs
  '';

  # Source tree of the gdextension-interface Haskell package:
  #   Godot.GDExtension.Interface  bindings for the C header, by hs-bindgen
  #   Godot.GDExtension.Functions  typed lookups, by ./GenFunctions.hs from
  #                                the interface JSON
  # plus the checked-in cabal file, and binding-spec.yaml, which lets later
  # hs-bindgen runs refer to these types instead of redefining them.
  gdextension-bindings = pkgs.runCommand "gdextension-interface-src"
    {
      nativeBuildInputs = [
        hs-bindgen-cli
        (pkgs.haskellPackages.ghcWithPackages (p: [ p.aeson ]))
      ];
    } ''
    hs-bindgen-cli preprocess \
      -I ${godot-api-json} \
      --hs-output-dir $out/src \
      --create-output-dirs \
      --module Godot.GDExtension.Interface \
      --unique-id gdextension-interface \
      --gen-binding-spec $out/binding-spec.yaml \
      gdextension_interface.h
    runghc -XImportQualifiedPost ${./GenFunctions.hs} \
      ${godot-api-json}/gdextension_interface.json \
      $out/src/Godot/GDExtension/Interface.hs \
      $out/src/Godot/GDExtension/Functions.hs
    cp ${./gdextension-interface.cabal} $out/gdextension-interface.cabal
  '';

  # Source tree of the godot-api Haskell package: the engine's classes,
  # builtin types and enums, generated by ./GenApi.hs from the API JSON, plus
  # the hand-written modules in ../api/src.
  godot-api-src = pkgs.runCommand "godot-api-src"
    {
      nativeBuildInputs = [
        (pkgs.haskellPackages.ghcWithPackages (p: [ p.aeson ]))
      ];
    } ''
    ghc -O1 -XImportQualifiedPost -outputdir build -o genapi ${./GenApi.hs}
    mkdir -p $out
    cp -r ${../api/src} $out/src
    cp -r ${../api/cbits} $out/cbits
    chmod -R u+w $out/src
    ./genapi ${godot-api-json}/extension_api.json $out/src ${pkgs.lib.escapeShellArgs selectedClasses}
    modules=$(sed 's/^/    /' $out/src/modules.txt)
    rm $out/src/modules.txt
    substitute ${./godot-api.cabal.in} $out/godot-api.cabal --subst-var-by MODULES "$modules"
  '';

  # Godot as a shared library; see ./libgodot.nix.
  libgodot = import ./libgodot.nix { inherit pkgs; };

  # Source tree of the godot-host Haskell package: hs-bindgen's binding of
  # libgodot.h, using the types of gdextension-interface through its binding
  # specification, plus the hand-written ../host/src.
  godot-host-src = pkgs.runCommand "godot-host-src"
    {
      nativeBuildInputs = [ hs-bindgen-cli ];
    } ''
    mkdir -p $out/include
    cp -r ${../host/src} $out/src
    chmod -R u+w $out/src
    # libgodot.h is taken from Godot's source, not from the built library, so
    # that evaluating this flake does not wait for the engine to compile. It
    # includes the interface header by its path in the source tree; point it
    # at the header the binding specification was made from, so that
    # hs-bindgen recognises the types.
    sed 's|"core/extension/gdextension_interface.gen.h"|"gdextension_interface.h"|' \
      ${pkgs.godot.src}/core/extension/libgodot.h > $out/include/libgodot.h
    cp ${godot-api-json}/gdextension_interface.h $out/include/
    hs-bindgen-cli preprocess \
      -I $out/include \
      --hs-output-dir $out/src \
      --module Godot.LibGodot \
      --unique-id godot-host \
      --external-binding-spec ${gdextension-bindings}/binding-spec.yaml \
      --select-by-header-path 'libgodot\.h' \
      --single-file --safe "" \
      libgodot.h
    cp ${./godot-host.cabal} $out/godot-host.cabal
  '';
}
